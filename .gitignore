### 我们后端的排除规则（草稿仓库里带过来的）###
# 编译产物 / 打包目录
target/
*.class

# 数据库文件默认不入库（*.db 多为运行时生成物）
*.db
*.db-journal
*.sqlite3

# 但 app.db 需入库，供团队成员 clone 后直接使用，避免各自重新初始化
!backend/db/app.db

# 图片/头像上传目录（运行时生成，不入库）
uploads/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# 编辑器
.idea/
*.swp
